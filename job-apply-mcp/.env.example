# Generate strong, distinct secrets: openssl rand -hex 32
PRIVATE_PROFILE_ACCESS_KEY=replace-with-a-long-random-key
PRIVATE_PROFILE_ENCRYPTION_KEY=replace-with-64-hex-characters
# Optional: a future approval relay can receive review events here.
APPROVAL_WEBHOOK_URL=
# Used by approve_application. Keep this in the approval relay, never in agent prompts.
APPLICATION_APPROVAL_KEY=replace-with-a-separate-random-key
